# Environment
NODE_ENV=development
# development, staging, production

# Debug mode
DEBUG=false

# CORS Origins (comma-separated)
CORS_ORIGINS=https://example.com,https://api.example.com

# Logging
# debug, info, warn, error
LOG_LEVEL=info

# DynamoDB table name (set by CDK output: assistance-{env}-claims)
CLAIMS_TABLE_NAME=assistance-dev-claims

# Secrets Manager secret ARN — injected by CDK in Lambda, leave blank for local dev
# APP_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:assistance/prod/app-xxx
# When blank, values below are read from this .env file directly

# JWT signing secret (stored in Secrets Manager as JWT_SECRET in prod)
JWT_SECRET=local-dev-secret-change-in-prod

# Comma-separated list of emails that get the adjuster role on login
ADJUSTER_EMAILS=adjuster@example.com,admin@example.com
